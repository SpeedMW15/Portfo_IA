# --- IA (Groq) ---
# Crea tu key gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Stellar ---
# "testnet" mientras pruebas, "mainnet" cuando conectes una cuenta real
STELLAR_NETWORK=testnet
# Clave PÚBLICA (empieza con G...). Nunca pongas aquí una clave secreta (S...)
STELLAR_PUBLIC_KEY=
# Déjalo vacío para usar el Horizon público por defecto de STELLAR_NETWORK
STELLAR_HORIZON_URL=
